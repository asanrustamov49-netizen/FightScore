# Copy to .env (npm run db:setup does it and generates the password). Never commit .env.
NODE_ENV=development
# dev-http: HTTP without TLS, only for localhost or a trusted isolated network (docs/ARCHITECTURE.md §9.1)
DEPLOY_MODE=dev-http
DEPLOY_TARGET=local
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgres://fightscore:CHANGE_ME@127.0.0.1:5432/fightscore
TEST_DATABASE_URL=postgres://fightscore:CHANGE_ME@127.0.0.1:5432/fightscore_test
PUBLIC_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_TTL_HOURS=12
# Organizer self sign-up: unset = on in dev-http, off in production
# ALLOW_REGISTRATION=true
# Password for demo users created by npm run seed:demo (development only). Empty on purpose:
# db:setup generates it; if you copy this file by hand, set your own (at least 8 characters).
DEMO_PASSWORD=
